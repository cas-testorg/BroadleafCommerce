{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboardApproval"
  ],

  "baseBranchPatterns": ["Integration"],
  "dependencyDashboardTitle": "Renovate Dashboard",

  "recreateWhen": "never",
  "rebaseWhen": "never",
  "semanticCommits": "disabled",

  "packageRules": [
    {
      "description": "Block Hibernate major upgrades and artifact replacements. Shared hibernate.version pins Hibernate 5.6 Jakarta-transition artifacts; majors/replacements require a dedicated ORM migration (see issue #37).",
      "matchUpdateTypes": ["major", "replacement"],
      "enabled": false,
      "matchPackageNames": [
        "/^org\\.hibernate(:|$)/",
        "/^org\\.hibernate\\.orm(:|$)/"
      ]
    }
  ]
}
